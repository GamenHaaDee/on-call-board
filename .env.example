# Kopieer dit bestand naar .env en vul je eigen waarden in.
# .env staat in .gitignore en wordt NOOIT gecommit.

# --- Backend / database ---
PORT=3001

# Welke database: "sqlite" (ingebouwd bestand — geen aparte databaseserver
# nodig), "mysql" (MySQL/MariaDB) of "postgres" (PostgreSQL).
# Laat dit leeg/weg om de keuze in de setup-pagina te maken; staat het hier
# wél, dan ligt de database vast en is hij in de UI niet wijzigbaar.
# DB_DRIVER=sqlite

# Alleen bij DB_DRIVER=sqlite: waar het databasebestand staat.
SQLITE_FILE=./data/rotacall.db

# Alleen bij DB_DRIVER=mysql of postgres (poort standaard 3306 resp. 5432):
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=changeme
# DB_PASSWORD=changeme
# DB_NAME=changeme

# Alternatief voor de losse velden hierboven (alleen Postgres):
# DATABASE_URL=postgres://user:wachtwoord@localhost:5432/rotacall

# Naam van de tabel (zie sql/period_config.sql resp. sql/period_config.pgsql).
# Bij sqlite en postgres wordt de tabel automatisch aangemaakt als hij ontbreekt.
DB_TABLE=period_config

# --- Rooster (geordende rotatielijst) ---
# Optioneel: zet de personen via deze env (handig in Docker/Portainer, dan
# hoeft er geen roster.json in de container). JSON-array, volgorde = rotatie.
# Laat leeg om server/roster.json (of roster.example.json) te gebruiken.
# ROSTER=[{"name":"Alice","phone":"0600000001"},{"name":"Bob","phone":"0600000002"}]

# --- Rotatie ---
# Anker = een maandag waarop de EERSTE persoon uit de roster aan de beurt is.
ROTATION_ANCHOR_DATE=2026-01-05
# Wisselmoment (bv. maandag 12:00 -> volgende maandag 11:59).
ROTATION_START_TIME=12:00:00
ROTATION_END_TIME=11:59:00
# Waarde voor pc_period.
ROTATION_PERIOD_VALUE=0
# Hoeveel weken vooruit de planning wordt aangevuld.
ROTATION_WEEKS_AHEAD=12

# Tijdzone van de planning (IANA-naam). Leeg = de tijdzone van de server;
# instelbaar in de setup-/instellingenpagina. Staat hij hier, dan ligt hij vast.
# ROTACALL_TIMEZONE=Europe/Amsterdam

# Wanneer de planning wordt aangevuld (cron). Standaard: elke maandag 00:05.
CRON_SCHEDULE=5 0 * * 1

# Optioneel wachtwoord voor de admin-pagina (/admin). Leeg = geen beveiliging
# (alleen doen op een afgeschermd intern netwerk). Kan ook via de setup-pagina.
ADMIN_TOKEN=

# Rooster, rotatie, mail, tijdzone en admin-token staan in de database, in
# deze tabel (wordt automatisch aangemaakt).
# SETTINGS_TABLE=rotacall_settings

# Waar de verbindingsgegevens van de database zelf worden bewaard. Kan de app
# de database niet bereiken, dan vallen de overige instellingen hier ook op
# terug.
# SETUP_FILE=./data/setup.json
# Bijhouden welke dienstmeldingen al verstuurd zijn.
# MAIL_STATE_FILE=./data/mail-state.json

# --- E-mailmeldingen (optioneel) ---
# Alles hieronder kan ook in de instellingenpagina; wat hier staat wint.
# SMTP_ENABLED=true
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=rota@example.com
# SMTP_PASSWORD=changeme
# SMTP_FROM=RotaCall <rota@example.com>
# Hoe vaak gekeken wordt of er gemaild moet worden (cron).
# MAIL_CHECK_SCHEDULE=*/5 * * * *

# --- Frontend (alleen bij losse hosting van de frontend) ---
# VITE_API_BASE=https://onduty.example.com
