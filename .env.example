# Kopieer dit bestand naar .env en vul je eigen waarden in.
# .env staat in .gitignore en wordt NOOIT gecommit.

# --- Backend / database ---
PORT=3001

DB_HOST=localhost
DB_PORT=3306
DB_USER=changeme
DB_PASSWORD=changeme
DB_NAME=changeme
# Naam van de tabel (zie sql/period_config.sql).
DB_TABLE=period_config

# --- Rooster (geordende rotatielijst) ---
# Optioneel: zet de personen via deze env (handig in Docker/Portainer, dan
# hoeft er geen roster.json in de container). JSON-array, volgorde = rotatie.
# Laat leeg om server/roster.json (of roster.example.json) te gebruiken.
# ROSTER=[{"name":"Alice","phone":"0600000001"},{"name":"Bob","phone":"0600000002"}]

# --- Rotatie ---
# Anker = een maandag waarop de EERSTE persoon uit de roster aan de beurt is.
ROTATION_ANCHOR_DATE=2026-01-05
# Wisselmoment (bv. maandag 12:00 -> volgende maandag 11:59).
ROTATION_START_TIME=12:00:00
ROTATION_END_TIME=11:59:00
# Waarde voor pc_period.
ROTATION_PERIOD_VALUE=0
# Hoeveel weken vooruit de planning wordt aangevuld.
ROTATION_WEEKS_AHEAD=12

# Wanneer de planning wordt aangevuld (cron). Standaard: elke maandag 00:05.
CRON_SCHEDULE=5 0 * * 1

# Optioneel wachtwoord voor de admin-pagina (/admin). Leeg = geen beveiliging
# (alleen doen op een afgeschermd intern netwerk).
ADMIN_TOKEN=

# --- Frontend (alleen bij losse hosting van de frontend) ---
# VITE_API_BASE=https://onduty.example.com
